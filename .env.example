# Required: token from @BotFather
BOT_TOKEN=

# Chat that receives booking / lead / handoff notifications and may use /export.
# Your own user id, or a group id (negative number). Get it from @userinfobot.
ADMIN_CHAT_ID=

# Business files (defaults point at the Smile Studio example)
BUSINESS_CONFIG=config/smile_studio.yaml
KNOWLEDGE_FILE=config/smile_studio_faq.yaml
DB_PATH=data/assistant.db

# Anti-spam: max messages per user per window (seconds)
RATE_LIMIT_MESSAGES=12
RATE_LIMIT_WINDOW_S=60

# Optional LLM polish of retrieved answers. OFF by default - the bot works fully without it.
# Any OpenAI-compatible endpoint (OpenAI, OpenRouter, a local Ollama/vLLM server, ...).
LLM_ENABLED=false
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
